# ===== 基础配置(必填,缺失时启动即失败) =====
# MySQL 连接串,示例:mysql+pymysql://root:password@127.0.0.1:3306/ai_portal?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ai_portal?charset=utf8mb4
# JWT 签名密钥(生产环境必须更换,禁止提交真实值)
SECRET_KEY=change-me-to-a-random-string

# ===== 模型密钥(只存环境变量,绝不入库、绝不进 git) =====
# 硅基流动 API Key(https://cloud.siliconflow.cn);未配置时线上模型调用报错,可用 Mock 全链路联调
SILICONFLOW_API_KEY=
# Ollama 本地服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ===== Provider 超时与重试 =====
# 连接超时(秒)
PROVIDER_CONNECT_TIMEOUT=10
# 读取超时(秒):文本 60 / 图像 120 / 音视频 300
PROVIDER_READ_TIMEOUT_TEXT=60
PROVIDER_READ_TIMEOUT_IMAGE=120
PROVIDER_READ_TIMEOUT_AV=300
# 失败重试次数(仅幂等请求,指数退避 1s/2s)
PROVIDER_MAX_RETRIES=2

# ===== 应用 =====
# 接口前缀(全组冻结为 /api)
API_PREFIX=/api
# 日志级别 DEBUG/INFO/WARNING
LOG_LEVEL=INFO
