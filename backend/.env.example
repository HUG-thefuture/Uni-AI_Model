# ===== 基础配置(必填,缺失时启动即失败) =====
# MySQL 连接串,示例:mysql+pymysql://root:password@127.0.0.1:3306/ai_portal?charset=utf8mb4
DATABASE_URL="mysql+aiomysql://root:root@127.0.0.1:3306/ai_portal?charset=utf8mb4"
# JWT 签名密钥(生产环境必须更换,禁止提交真实值)
SECRET_KEY="change-me-to-a-random-string"

# ===== 模型密钥(只存环境变量,绝不入库、绝不进 git) =====
# 硅基流动 API Key(https://cloud.siliconflow.cn);未配置时线上模型调用报错,可用 Mock 全链路联调
SILICONFLOW_API_KEY=
# 阿里云百炼 DashScope API Key(https://bailian.console.aliyun.com);未配置时 dashscope 模型调用报错
DASHSCOPE_API_KEY=
# Ollama 本地服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ===== Provider 超时与重试 =====
# 连接超时(秒)
PROVIDER_CONNECT_TIMEOUT=10
# 读取超时(秒):文本 60 / 图像 120 / 音视频 300
PROVIDER_READ_TIMEOUT_TEXT=60
PROVIDER_READ_TIMEOUT_IMAGE=120
PROVIDER_READ_TIMEOUT_AV=300
# 失败重试次数(仅幂等请求,指数退避 1s/2s)
PROVIDER_MAX_RETRIES=2

# ===== 应用 =====
# 接口前缀(全组冻结为 /api)
API_PREFIX=/api
# 日志级别 DEBUG/INFO/WARNING
LOG_LEVEL=INFO
# CORS 白名单(逗号分隔完整来源;为空仅允许 localhost/127.0.0.1)
# 生产示例:CORS_ORIGINS=https://portal.example.com,https://www.example.com
CORS_ORIGINS=

# ===== 鉴权 =====
# JWT 有效期(小时,全组冻结 24h)
JWT_EXPIRE_HOURS=24

# ===== 短信验证(阿里云 Dysmsapi) =====
# 阿里云 AccessKey(建议使用 RAM 子账号,仅授权 AliyunDysmsFullAccess)
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名与模板 CODE(控制台审核通过后获得;免费演示可用「测试签名/模板」+白名单手机号)
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 调试模式:未配置阿里云密钥时回显验证码到响应(仅开发/演示环境开启!)
SMS_DEBUG=false
# 验证码有效期(秒)/最大校验次数/同号每日上限/同IP每日上限
SMS_CODE_EXPIRE_SEC=300
SMS_CODE_MAX_ATTEMPTS=5
SMS_SEND_PER_DAY=10
SMS_IP_SEND_PER_DAY=20

# ===== 支付(支付宝沙箱;未配置时自动使用内置模拟收银台) =====
# 开放平台沙箱 APPID(https://open.alipay.com → 沙箱环境)
ALIPAY_APP_ID=
# 应用私钥(沙箱界面可生成,支持 PEM 全文或纯 base64)
ALIPAY_PRIVATE_KEY=
# 支付宝公钥(注意:不是你的应用公钥,用于回执验签)
ALIPAY_PUBLIC_KEY=
# 网关地址(默认沙箱;生产替换为 https://openapi.alipay.com/gateway.do)
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 异步通知地址(需公网可达;本地开发可留空,用回跳后同步查单闭环)
ALIPAY_NOTIFY_URL=
# 支付完成浏览器回跳地址(如 http://127.0.0.1:4174/pay.html)
ALIPAY_RETURN_URL=

# ===== 运营 =====
# 新用户注册赠送积分(便于新用户零门槛体验模型)
DEFAULT_REGISTER_POINTS=10
# 盈利:按 token 计费模型的售价 = 供应商成本价 × 加价比例(130 = 加价 30%);
# 模型行的 token_markup_pct 非空时优先生效(管理端模型表单可配)
TOKEN_MARKUP_PCT=130

# ===== SSE 流式 =====
SSE_FIRST_BYTE_TIMEOUT=15
SSE_TOTAL_TIMEOUT=120

# ===== 上传与素材 =====
# 上传文件落盘目录(相对 backend/ 或绝对路径)
UPLOAD_DIR=uploads

# ===== 开放平台 =====
# 单 API Key 每分钟调用上限
OPENAPI_RATE_LIMIT_PER_MIN=30

# ===== 长耗时任务 =====
VIDEO_POLL_INTERVAL_SEC=5
VIDEO_POLL_MAX_SEC=300
